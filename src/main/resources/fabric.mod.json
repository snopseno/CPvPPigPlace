{
	"schemaVersion": 1,
	"id": "cpvppigplace",
	"version": "2.0",
	"name": "CpvpPigPlace",
	"description": "Replicates the Crystal PvP keyboard-remapping trick directly for your standard mouse buttons or custom keyboard keys, enabling zero-delay block placing and entity attacking when held down.",
	"authors": [
		"Snopseno"
	],
	"license": "MIT",
	"icon": "assets/cpvppigplace/icon.png",
	"environment": "client",
	 "entrypoints": {
		"main": [
			"com.snopseno.ExampleMod"
		],
		"client": [
			"com.snopseno.client.ExampleModClient"
		],
		"modmenu": [
			"com.snopseno.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "cpvppigplace.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}